# Postgres connection used by packages/database (Prisma) and apps/web (the
# API routes live inside it now — see CONTEXT.md "Architecture"). This
# project does NOT run its own Postgres container — it connects to the
# shared local dev DB stack in ../database (docker-compose, network
# `db-network`). Copy the real "app" DB connection string for PostgreSQL out
# of ../database/skills.md into your local .env (never commit real values):
#   - running on the host (e.g. `npm run dev`): use localhost:5432
#   - running inside a container attached to `db-network`: use host
#     `db-postgres` instead of `localhost`
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/app?schema=daily_routine"

# Used by docker-compose.yml to build the container's DATABASE_URL
# (host `db-postgres` instead of `localhost`, over the shared `db-network`).
# Same password as above — keep the two in sync.
POSTGRES_PASSWORD=<password>

# Signs the auth JWT (httpOnly cookie). Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<random 32+ byte hex string>"
