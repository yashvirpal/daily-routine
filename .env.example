# Postgres connection used by packages/database (Prisma) and apps/web (the
# API routes live inside it now — see CONTEXT.md "Architecture"). This
# project does NOT run its own Postgres container — it connects to the
# shared local dev DB stack in ../database (docker-compose, network
# `db-network`). Copy the real "app" DB connection string for PostgreSQL out
# of ../database/skills.md into your local .env (never commit real values):
#   - running on the host (e.g. `npm run dev`): use localhost:5432
#   - running inside a container attached to `db-network`: use host
#     `db-postgres` instead of `localhost`
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/app?schema=daily_routine"

# Used only for `prisma migrate`/`db push` — see the comment on `directUrl`
# in schema.prisma. Locally there's no connection proxy, so this is just a
# copy of DATABASE_URL above. (In production with Prisma Postgres, DATABASE_URL
# becomes an Accelerate "prisma+postgres://" URL and DIRECT_URL becomes the
# real Postgres connection string Prisma Postgres gives you alongside it.)
DIRECT_URL="postgresql://postgres:<password>@localhost:5432/app?schema=daily_routine"

# Used by docker-compose.yml to build the container's DATABASE_URL
# (host `db-postgres` instead of `localhost`, over the shared `db-network`).
# Same password as above — keep the two in sync.
POSTGRES_PASSWORD=<password>

# Signs the auth JWT (httpOnly cookie). Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<random 32+ byte hex string>"

# Email (welcome, password reset, daily summary) — see lib/server/email.ts.
# Get a key at resend.com. Left unset, emails are skipped (logged, not sent)
# rather than crashing whatever triggered them.
RESEND_API_KEY="re_..."
# Optional — defaults to Resend's sandbox sender, which only actually
# delivers to the email you signed up to Resend with. Set this once you've
# verified your own sending domain there.
# EMAIL_FROM="Daily Routine <hello@yourdomain.com>"

# Used to build absolute links in emails (password reset, "go to Today")
# and SEO metadata. Required locally (see lib/server/app-url.ts). On
# Vercel this is optional — it falls back to Vercel's auto-injected
# VERCEL_PROJECT_PRODUCTION_URL if unset — but set it explicitly if you're
# on a custom domain, or if you ever hit the exact bug that motivated this
# fallback: APP_URL showed correctly in the dashboard but still read back
# as undefined at runtime (cause never fully diagnosed; the fallback made
# it moot).
APP_URL="http://localhost:3000"

# Authenticates the daily summary cron (app/api/cron/daily-summary) —
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`
# for a cron job defined in vercel.json once this is set as an env var.
# Optional locally (the route allows unauthenticated calls if unset, so you
# can test it directly), but set this in production.
# CRON_SECRET="<random string>"
