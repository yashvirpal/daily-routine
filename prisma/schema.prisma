// Prisma schema for the Daily Routine & Habit Tracker.
//
// Connects to the shared local Postgres instance (see ../../../../database)
// using a dedicated `daily_routine` schema (set via the `schema` query param
// on DATABASE_URL) so this project's tables don't collide with other
// projects sharing the same "app" database.
//
// Multi-user: every Routine belongs to a User. Role gates the admin panel
// (ADMIN sees/manages everything; USER sees only their own routines/check-ins)
// — see CONTEXT.md "Auth & Roles". The first user ever registered becomes
// ADMIN automatically (bootstrap — there's no separate seed step); everyone
// after that registers as USER.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Only meaningful in production (Prisma Postgres/Accelerate): DATABASE_URL
  // there is a "prisma+postgres://" proxy URL that `prisma migrate`/`db push`
  // can't use directly, so those commands use this real Postgres URL instead
  // — Prisma CLI picks directUrl over url automatically when both are set.
  // Local dev (Docker) has no proxy, so DIRECT_URL is just a copy of
  // DATABASE_URL there — see .env.example.
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Frequency {
  DAILY
  WEEKLY
  CUSTOM
  MONTHLY
  ONCE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routines             Routine[]
  passwordResetTokens  PasswordResetToken[]
}

/// A "forgot password" link. `tokenHash` (not the raw token) is what's
/// stored, so a DB leak alone can't be used to reset anyone's password —
/// the raw token only ever exists in the emailed link and briefly in
/// memory when checking it. Single-use (`usedAt`) and short-lived
/// (`expiresAt`).
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Routine {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String? // lucide-react icon name
  color       String? // Tailwind color token, e.g. "emerald"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  frequency   Frequency @default(DAILY)
  /// For WEEKLY/CUSTOM: days of week this routine is due, 0 (Sun) - 6 (Sat).
  /// Empty for DAILY.
  daysOfWeek  Int[]     @default([])
  /// For MONTHLY (by-date mode): days of month this routine is due, 1-31.
  daysOfMonth Int[]     @default([])
  /// For MONTHLY (by-weekday mode): 1-4, or -1 for "last". Null if unused
  /// (falls back to daysOfMonth).
  monthlyWeekOrdinal Int?
  /// For MONTHLY (by-weekday mode): 0 (Sun) - 6 (Sat). Null if unused.
  monthlyWeekday     Int?
  /// For ONCE: the single calendar date this routine is due. Null otherwise.
  onceDate    DateTime? @db.Date
  targetCount Int       @default(1) // times per due day to mark complete

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns DailyLog[]

  @@index([userId, isActive])
}

/// Site-wide config, admin-editable. Singleton row (id is always
/// "singleton") — see getAppSettings()'s upsert, which creates it lazily so
/// there's no separate seed step, consistent with the rest of this app.
model AppSettings {
  id               String   @id @default("singleton")
  siteName         String   @default("Daily Routine")
  registrationOpen Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model DailyLog {
  id String @id @default(cuid())

  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  /// Calendar day this check-in is for (time component ignored).
  date      DateTime @db.Date
  completed Boolean  @default(true)
  count     Int      @default(1) // supports targetCount > 1
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routineId, date])
  @@index([date])
}
